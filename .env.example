# Public control application
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHOWCASE_URL=http://localhost:3000/showcase
SHOWCASE_BASE_URL=http://localhost:3000/showcase
SEED_DEMO_DATA=true

# Trusted operator and runner
OPS_PASSCODE=qoder-live
OPS_SESSION_SECRET=replace-with-a-long-random-value
RUNNER_TOKEN=replace-with-a-long-random-value
CONTROL_BASE_URL=http://localhost:3000
RUNNER_PROVIDER=qca
DRY_RUN=true

# Qoder Cloud Agents (required when DRY_RUN=false)
QODER_PAT=
QODER_CLOUD_AGENT_ID=
QODER_CLOUD_ENVIRONMENT_ID=
QODER_API_BASE=https://api.qoder.com/api/v1/cloud
QODER_BOOTSTRAP_MODEL=ultimate

# Candidate GitHub repository
GITHUB_REPOSITORY_URL=https://github.com/lemondepat/qoder-live-lab
GITHUB_TOKEN=
GITHUB_DEFAULT_BRANCH=main

# Immutable Vercel previews
VERCEL_TOKEN=
VERCEL_SHOWCASE_PROJECT_ID=

# Time budgets
AGENT_TIMEOUT_MS=180000
TASK_TIMEOUT_MS=300000
RUNNER_POLL_MS=2000
